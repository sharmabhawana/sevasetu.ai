# Sewa Setu Production Environment Configuration Template
# Copy this file to .env before starting the stack: cp .env.example .env

# Public URL of the portal (used in JWTs and OAuth discovery)
PUBLIC_BASE_URL=https://sewasetu.example.in

# Department Administrator credentials (replace with secure values in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-production-password

# Assessor Administrator credentials (replace with secure values in production)
ASSESSOR_USERNAME=assessor_admin
ASSESSOR_PASSWORD=change-me-to-a-secure-production-password

# Flask secret key for session signing (generate a strong random value)
SECRET_KEY=change-me-to-a-random-secret-key-for-session-signing

# PostgreSQL database configuration (ensure matching the docker-compose db service)
DB_HOST=db
DB_PORT=5432
DB_NAME=sewasetu
DB_USER=sewasetu
DB_PASSWORD=sewasetu123

# FastMCP Citizen server configuration
CITIZEN_MCP_HOST=0.0.0.0
CITIZEN_MCP_PORT=8001
# Audience claim expected in citizen JWTs
CITIZEN_MCP_AUDIENCE=https://sewasetu.example.in/mcp/citizen

# FastMCP Officer server configuration (not exposed in Citizen MCP)
OFFICER_MCP_HOST=0.0.0.0
OFFICER_MCP_PORT=8002
OFFICER_MCP_AUDIENCE=https://sewasetu.example.in/mcp/officer
